{
  "name": "@local/xiaoqian-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Harness-native WeChat bridge with isolated desktop driver",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "{adapter,compat,driver,legacy,src,tools,vendor}/**/*.{mjs,js,py,pyw,css,html}",
    "{compat/vendor,vendor}/calendar-*.json",
    "src/rotation-observer/calculator/official-cny-snapshot.json",
    "tools/mobile-status/{README.md,requirements.txt}",
    "vendor/official-provider-balance/{LICENSE,PROVENANCE.json}",
    "vendor/owner-tools/{*.md,PYPDF-LICENSE,pdf-deps.zip,source-manifest.json}",
    "vendor/xiaoqian_schedule/price-card.json",
    "cordis.patch.yml",
    "docs/*.md",
    "docs/config.example.json",
    "NOTICE.md",
    "SOURCE.json",
    "requirements-windows.txt",
    "!**/{test,tests,__pycache__}/**",
    "!**/*.test.*",
    "!**/test_*.py",
    "!**/test.mjs",
    "!**/*.bak*",
    "!**/xiaoqian_schedule/demo.py"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.mjs",
    "check": "node --check src/index.mjs"
  }
}
